# All optional -- the app runs with these defaults if the file is absent.

# Where SQLite lives. Delete the .db file to reset and re-seed demo data.
DATABASE_URL=sqlite:///parkin.db

# Change this before deploying anywhere real.
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_DAYS=7

# Browsers allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long an unpaid booking holds its bay before the sweeper releases it.
RESERVATION_HOLD_MINUTES=10
EXPIRY_SWEEP_SECONDS=20

# Set false to start with an empty database.
SEED_ON_STARTUP=true
DEMO_RESET_ENABLED=true

# Optional. Leave blank to keep checkout simulated (no money moves).
# With both set, UPI/card open Razorpay Checkout; cash stays local.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. Destination search (Search Bay) uses Google Places + Geocoding when
# set. Leave blank to use OpenStreetMap, still biased to Jaipur.
GOOGLE_MAPS_API_KEY=

# Provision this on physical edge devices as the X-Device-Key header.
SENSOR_INGEST_KEY=dev-sensor-key-change-me

# All optional -- the app runs with these defaults if the file is absent.

# Where SQLite lives. Delete the .db file to reset and re-seed demo data.
DATABASE_URL=sqlite:///parkin.db

# Change this before deploying anywhere real.
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_DAYS=7

# Browsers allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long an unpaid booking holds its bay before the sweeper releases it.
RESERVATION_HOLD_MINUTES=10
EXPIRY_SWEEP_SECONDS=20

# Set false to start with an empty database.
SEED_ON_STARTUP=true

# Where the FastAPI backend is listening.
#
# Only needed for `npm run dev`, where Vite serves this app on :5173 and the API
# runs separately on :8000. Leave it unset in a production build: the deployed
# FastAPI process serves this bundle itself, so the app talks to its own origin
# and there is no host to keep in sync.
VITE_API_URL=http://localhost:8000
